{
  "name": "w2agent",
  "version": "0.1.0",
  "license": "MIT",
  "description": "CLI tool for w2agent — generate llms.txt, agent cards, and MCP declarations for any website",
  "author": "w2agent",
  "homepage": "https://w2agent.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/w2agent/w2agent.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "llms.txt",
    "mcp",
    "ai-agent",
    "w2agent",
    "cli",
    "openapi"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "w2agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "biome check .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@w2agent/core": "workspace:*",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "^2.7.0"
  }
}
