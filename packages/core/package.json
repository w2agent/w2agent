{
  "name": "w2agent-core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Core crawl and MCP generation engine for w2agent",
  "author": "w2agent",
  "homepage": "https://w2agent.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/interskh/w2agent.git",
    "directory": "packages/core"
  },
  "keywords": [
    "llms.txt",
    "mcp",
    "ai-agent",
    "w2agent",
    "crawler",
    "openapi"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome check .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "robots-parser": "^3.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "h3": "^1.15.10",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
