{
  "name": "@w2agent/nuxt",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Nuxt module for w2agent — auto-registers llms.txt, agent-card.json, and webhook routes",
  "author": "w2agent",
  "homepage": "https://w2agent.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/interskh/w2agent.git",
    "directory": "packages/nuxt"
  },
  "keywords": [
    "llms.txt",
    "mcp",
    "ai-agent",
    "w2agent",
    "nuxt",
    "nuxt-module"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/module.js",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "biome check .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nuxt/kit": "^3.0.0"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "h3": "^1.0.0",
    "nuxt": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
